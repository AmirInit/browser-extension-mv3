index 0000000..1fa8fcc
--- /dev/null
+++ b/tests/helpers/webextReduxHarness.cjs
@@ -0,0 +1,62 @@
+// Model only the browser messaging transport. The real webext-redux package
+// and a real Redux store are used by the callers of this helper.
+global.self = global
+
+function createHarness(tabCount) {
+  const workerListeners = []
+  const workerExternalListeners = []
+  const pages = new Set()
+  const counts = { tabQueries: 0, tabMessages: 0, runtimeBroadcasts: 0 }
+
+  const worker = {
+    runtime: {
+      onMessage: { addListener: listener => workerListeners.push(listener) },
+      onMessageExternal: { addListener: listener => workerExternalListeners.push(listener) },
+      sendMessage(message, callback) {
+        counts.runtimeBroadcasts++
+        for (const listeners of pages) {
+          for (const listener of listeners) listener(message, {}, () => {})
+        }
+        if (callback) callback()
+      },
+    },
+    tabs: {
+      query(_query, callback) {
+        counts.tabQueries++
+        callback(Array.from({ length: tabCount }, (_, id) => ({ id: id + 1 })))
+      },
+      sendMessage(_tabId, _message, callback) {
+        counts.tabMessages++
+        if (callback) callback()
+      },
+    },
+  }
+
+  function page() {
+    const listeners = []
+    pages.add(listeners)
+    return {
+      runtime: {
+        onMessage: { addListener: listener => listeners.push(listener) },
+        sendMessage(_extensionId, message, _options, callback) {
+          // Real extension messaging is asynchronous. In particular, the
+          // proxy's constructor finishes before its fetch response arrives.
+          queueMicrotask(() => {
+            for (const listener of workerListeners) {
+              listener(message, { id: 'test-extension' }, callback)
+            }
+          })
+        },
+      },
+    }
+  }
+
+  function restartWorker() {
+    workerListeners.length = 0
+    workerExternalListeners.length = 0
+  }
+
+  return { worker, page, counts, restartWorker }
+}
+
+module.exports = { createHarness }
diff --git a/tests/performance/browserReduxBench.cjs b/tests/performance/browserReduxBench.cjs
new file mode 100644
index 0000000..ca31d7b
--- /dev/null
+++ b/tests/performance/browserReduxBench.cjs
@@ -0,0 +1,219 @@
+// Isolated Vivaldi benchmark for the real webext-redux transport. It does not
+// load a Windscribe profile or access the network. For an unpatched baseline,
+// set WS_BENCH_NODE_MODULES to a separate clean install of the dependency.
+const assert = require('node:assert/strict')
+const fs = require('node:fs')
+const os = require('node:os')
+const path = require('node:path')
+const { performance } = require('node:perf_hooks')
+const esbuild = require('esbuild')
+const puppeteer = require('puppeteer-core')
+
+const dependencyRoot = path.resolve(process.env.WS_BENCH_NODE_MODULES || 'node_modules')
+const executablePath = process.env.VIVALDI_BINARY || '/opt/vivaldi/vivaldi-bin'
+const maxTabs = Number(process.env.WS_BENCH_MAX_TABS || 100)
+const maxRssKiB = 6 * 1024 * 1024
+const minAvailableKiB = 6 * 1024 * 1024
+const root = fs.mkdtempSync(path.join(os.tmpdir(), 'windscribe-redux-browser-bench-'))
+const extension = path.join(root, 'extension')
+fs.mkdirSync(extension)
+
+const workerSource = `
+  const { wrapStore } = require('@eduardoac-skimlinks/webext-redux')
+  const { createStore } = require('redux')
+  const originalSend = chrome.tabs.sendMessage.bind(chrome.tabs)
+  globalThis.tabMessagesSent = 0
+  chrome.tabs.sendMessage = (...args) => { globalThis.tabMessagesSent++; return originalSend(...args) }
+  globalThis.testStore = createStore((state = { counter: 0 }, action) =>
+    action.type === 'increment' ? { counter: state.counter + 1 } : state)
+  wrapStore(globalThis.testStore, { portName: 'WS_BROWSER_EXTENSION_STORE' })
+`
+const pageSource = `
+  const { Store } = require('@eduardoac-skimlinks/webext-redux')
+  globalThis.testStore = new Store({ portName: 'WS_BROWSER_EXTENSION_STORE' })
+`
+
+function availableMemoryKiB() {
+  const line = fs
+    .readFileSync('/proc/meminfo', 'utf8')
+    .split('\n')
+    .find(s => s.startsWith('MemAvailable:'))
+  return Number(line.match(/\d+/)[0])
+}
+
+function browserProcessStats(rootPid) {
+  const processes = new Map()
+  for (const pid of fs.readdirSync('/proc').filter(s => /^\d+$/.test(s))) {
+    try {
+      const stat = fs.readFileSync(`/proc/${pid}/stat`, 'utf8')
+      const fields = stat.slice(stat.lastIndexOf(')') + 2).split(' ')
+      processes.set(Number(pid), Number(fields[1]))
+    } catch (_) {}
+  }
+  const descendants = new Set([rootPid])
+  let changed = true
+  while (changed) {
+    changed = false
+    for (const [pid, parent] of processes) {
+      if (descendants.has(parent) && !descendants.has(pid)) {
+        descendants.add(pid)
+        changed = true
+      }
+    }
+  }
+  let rssKiB = 0
+  let fdCount = 0
+  for (const pid of descendants) {
+    try {
+      const status = fs.readFileSync(`/proc/${pid}/status`, 'utf8')
+      rssKiB += Number(status.match(/^VmRSS:\s+(\d+)/m)?.[1] || 0)
+      fdCount += fs.readdirSync(`/proc/${pid}/fd`).length
+    } catch (_) {}
+  }
+  return { processes: descendants.size, rssKiB, fdCount }
+}
+
+async function main() {
+  fs.writeFileSync(
+    path.join(extension, 'manifest.json'),
+    JSON.stringify({
+      manifest_version: 3,
+      name: 'Isolated Redux transport benchmark',
+      version: '1.0',
+      permissions: ['tabs'],
+      background: { service_worker: 'worker.js' },
+    }),
+  )
+  fs.writeFileSync(
+    path.join(extension, 'client.html'),
+    '<!doctype html><script src="client.js"></script>',
+  )
+  for (const [source, output] of [
+    [workerSource, 'worker.js'],
+    [pageSource, 'client.js'],
+  ]) {
+    await esbuild.build({
+      stdin: { contents: source, resolveDir: root },
+      nodePaths: [dependencyRoot],
+      bundle: true,
+      platform: 'browser',
+      outfile: path.join(extension, output),
+      logLevel: 'silent',
+    })
+  }
+
+  const browser = await puppeteer.launch({
+    executablePath,
+    headless: true,
+    pipe: true,
+    ignoreDefaultArgs: ['--disable-extensions'],
+    // Limit renderer processes in this synthetic, offline fixture so that a
+    // large tab-count test does not crowd out the user's real applications.
+    args: [
+      `--disable-extensions-except=${extension}`,
+      `--load-extension=${extension}`,
+      '--no-first-run',
+      '--renderer-process-limit=8',
+    ],
+  })
+  try {
+    const workerTarget = await browser.waitForTarget(
+      t => t.type() === 'service_worker' && t.url().endsWith('/worker.js'),
+      { timeout: 30000 },
+    )
+    const worker = await workerTarget.worker()
+    const extensionOrigin = `chrome-extension://${new URL(workerTarget.url()).host}`
+    const page = await browser.newPage()
+    await page.goto(`${extensionOrigin}/client.html`)
+    await page.evaluate(() => globalThis.testStore.ready())
+    assert.equal(await page.evaluate(() => globalThis.testStore.getState().counter), 0)
+    const cdp = await browser.target().createCDPSession()
+    const browserPid = browser.process().pid
+
+    for (const target of [100, 500, 1000, 3000].filter(n => n <= maxTabs)) {
+      let current = await worker.evaluate(async () => (await chrome.tabs.query({})).length)
+      let stopped = false
+      while (current < target) {
+        const batch = Math.min(10, target - current)
+        await worker.evaluate(async count => {
+          for (let i = 0; i < count; i++) {
+            const tab = await chrome.tabs.create({ url: 'about:blank', active: false })
+            try {
+              await chrome.tabs.discard(tab.id)
+            } catch (_) {}
+          }
+        }, batch)
+        current += batch
+        const stats = browserProcessStats(browserPid)
+        if (availableMemoryKiB() < minAvailableKiB || stats.rssKiB > maxRssKiB) {
+          console.log(JSON.stringify({ target, stoppedForMemory: true, current, ...stats }))
+          stopped = true
+          break
+        }
+      }
+      if (stopped) break
+
+      let channels = 0
+      let channelDurationMs = 0
+      const onData = ({ value }) => {
+        for (const event of value) {
+          if (event.name === 'ServiceWorkerHost::OpenChannelToTab' && event.ph === 'X') {
+            channels++
+            channelDurationMs += (event.dur || 0) / 1000
+          }
+        }
+      }
+      cdp.on('Tracing.dataCollected', onData)
+      let tracingComplete
+      const done = new Promise(resolve => {
+        tracingComplete = resolve
+      })
+      cdp.once('Tracing.tracingComplete', tracingComplete)
+      await cdp.send('Tracing.start', {
+        categories: 'toplevel,extensions,__metadata',
+        transferMode: 'ReportEvents',
+      })
+      const before = await worker.evaluate(() => globalThis.tabMessagesSent)
+      const start = performance.now()
+      await worker.evaluate(() => {
+        for (let i = 0; i < 3; i++) globalThis.testStore.dispatch({ type: 'increment' })
+      })
+      const latency = []
+      const deadline = performance.now() + 4000
+      while (performance.now() < deadline) {
+        const t = performance.now()
+        await browser.version()
+        latency.push(performance.now() - t)
+        await new Promise(resolve => setTimeout(resolve, 100))
+      }
+      const sent = (await worker.evaluate(() => globalThis.tabMessagesSent)) - before
+      const counter = await page.evaluate(() => globalThis.testStore.getState().counter)
+      await cdp.send('Tracing.end')
+      await done
+      cdp.off('Tracing.dataCollected', onData)
+      latency.sort((a, b) => a - b)
+      console.log(
+        JSON.stringify({
+          tabCount: current,
+          updates: 3,
+          sent,
+          channels,
+          channelDurationMs: Math.round(channelDurationMs * 10) / 10,
+          probeP95Ms: Math.round(latency[Math.floor((latency.length - 1) * 0.95)] * 10) / 10,
+          elapsedMs: Math.round(performance.now() - start),
+          counter,
+          ...browserProcessStats(browserPid),
+          availableKiB: availableMemoryKiB(),
+        }),
+      )
+    }
+  } finally {
+    await browser.close()
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+}
+
+main().catch(err => {
+  console.error(err.stack || err)
+  process.exitCode = 1
+})
diff --git a/tests/performance/reduxBroadcast.bench.cjs b/tests/performance/reduxBroadcast.bench.cjs
new file mode 100644
index 0000000..7bf0708
--- /dev/null
+++ b/tests/performance/reduxBroadcast.bench.cjs
@@ -0,0 +1,24 @@
+// A transport-level scaling benchmark, not a substitute for browser traces.
+const { performance } = require('node:perf_hooks')
+const { createStore } = require('redux')
+const { wrapStore } = require('@eduardoac-skimlinks/webext-redux')
+const { createHarness } = require('../helpers/webextReduxHarness.cjs')
+
+for (const tabCount of [100, 500, 1000, 3000]) {
+  const harness = createHarness(tabCount)
+  global.chrome = harness.worker
+  const store = createStore((state = { counter: 0 }, action) =>
+    action.type === 'increment' ? { counter: state.counter + 1 } : state,
+  )
+  const start = performance.now()
+  wrapStore(store, { portName: 'WS_BROWSER_EXTENSION_STORE' })
+  for (let i = 0; i < 20; i++) store.dispatch({ type: 'increment' })
+  console.log(
+    JSON.stringify({
+      tabCount,
+      updates: 20,
+      ...harness.counts,
+      elapsedMs: performance.now() - start,
+    }),
+  )
+}
diff --git a/tests/unit/reduxBroadcast.test.cjs b/tests/unit/reduxBroadcast.test.cjs
new file mode 100644
index 0000000..656c686
--- /dev/null
+++ b/tests/unit/reduxBroadcast.test.cjs
@@ -0,0 +1,83 @@
+const assert = require('node:assert/strict')
+const { afterEach, test } = require('node:test')
+const { createStore } = require('redux')
+const { Store, wrapStore } = require('@eduardoac-skimlinks/webext-redux')
+const { createHarness } = require('../helpers/webextReduxHarness.cjs')
+
+const portName = 'WS_BROWSER_EXTENSION_STORE'
+
+function reducer(state = { counter: 0, privacy: true }, action) {
+  if (action.type === 'increment') return { ...state, counter: state.counter + 1 }
+  if (action.type === 'privacy') return { ...state, privacy: action.payload }
+  return state
+}
+
+afterEach(() => {
+  delete global.chrome
+})
+
+for (const tabCount of [100, 500, 1000, 3000]) {
+  test(`Redux sync reaches extension pages without broadcasting to ${tabCount} tabs`, async () => {
+    const harness = createHarness(tabCount)
+    global.chrome = harness.worker
+    const background = createStore(reducer)
+    wrapStore(background, { portName })
+
+    global.chrome = harness.page()
+    const popup = new Store({ portName })
+    await popup.ready()
+    global.chrome = harness.page()
+    const debugPage = new Store({ portName })
+    await debugPage.ready()
+
+    assert.deepEqual(popup.getState(), background.getState())
+    assert.deepEqual(debugPage.getState(), background.getState())
+    await popup.dispatch({ type: 'increment' })
+    await popup.dispatch({ type: 'privacy', payload: false })
+    assert.deepEqual(popup.getState(), { counter: 1, privacy: false })
+    assert.deepEqual(debugPage.getState(), background.getState())
+
+    // A no-op action must not produce a new state message.
+    const messagesBeforeNoOp = harness.counts.runtimeBroadcasts
+    background.dispatch({ type: 'noop' })
+    assert.equal(harness.counts.runtimeBroadcasts, messagesBeforeNoOp)
+    assert.equal(harness.counts.tabQueries, 0)
+    assert.equal(harness.counts.tabMessages, 0)
+  })
+}
+
+test('a restarted worker can synchronize an existing extension page and new popup', async () => {
+  const harness = createHarness(3000)
+  global.chrome = harness.worker
+  const firstWorker = createStore(reducer)
+  wrapStore(firstWorker, { portName })
+  global.chrome = harness.page()
+  const existingPage = new Store({ portName })
+  await existingPage.ready()
+  await existingPage.dispatch({ type: 'increment' })
+
+  // The real worker is recreated from persisted state; existing extension
+  // pages and their listeners remain separate browser contexts.
+  const persistedState = firstWorker.getState()
+  harness.restartWorker()
+  global.chrome = harness.worker
+  const secondWorker = createStore(reducer, persistedState)
+  wrapStore(secondWorker, { portName })
+  await existingPage.dispatch({ type: 'privacy', payload: false })
+  assert.deepEqual(existingPage.getState(), secondWorker.getState())
+
+  global.chrome = harness.page()
+  const reopenedPopup = new Store({ portName })
+  await reopenedPopup.ready()
+  assert.deepEqual(reopenedPopup.getState(), { counter: 1, privacy: false })
+  assert.equal(harness.counts.tabQueries, 0)
+  assert.equal(harness.counts.tabMessages, 0)
+})
+
+test('unrelated tab messaging remains available', () => {
+  const harness = createHarness(1)
+  global.chrome = harness.worker
+  wrapStore(createStore(reducer), { portName })
+  harness.worker.tabs.sendMessage(1, { type: 'privacy-feature-message' }, () => {})
+  assert.equal(harness.counts.tabMessages, 1)
+})
diff --git a/tests/unit/reduxPatchInstallation.test.cjs b/tests/unit/reduxPatchInstallation.test.cjs
new file mode 100644
index 0000000..d307360
--- /dev/null
+++ b/tests/unit/reduxPatchInstallation.test.cjs
@@ -0,0 +1,43 @@
+const assert = require('node:assert/strict')
+const { spawnSync } = require('node:child_process')
+const fs = require('node:fs')
+const os = require('node:os')
+const path = require('node:path')
+const { test } = require('node:test')
+
+test('the dependency patch applies cleanly, is idempotent, and refuses mismatched files', t => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'windscribe-redux-install-test-'))
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }))
+  for (const directory of ['scripts', 'patches', 'node_modules/@eduardoac-skimlinks']) {
+    fs.mkdirSync(path.join(root, directory), { recursive: true })
+  }
+  for (const file of ['applyReduxBroadcastPatch.js', 'verifyReduxBroadcastPatch.js']) {
+    fs.copyFileSync(path.join('scripts', file), path.join(root, 'scripts', file))
+  }
+  const patchName = '@eduardoac-skimlinks+webext-redux+3.0.1-release-candidate.patch'
+  fs.copyFileSync(path.join('patches', patchName), path.join(root, 'patches', patchName))
+  const installedPackage = path.dirname(
+    require.resolve('@eduardoac-skimlinks/webext-redux/package.json'),
+  )
+  fs.cpSync(installedPackage, path.join(root, 'node_modules/@eduardoac-skimlinks/webext-redux'), {
+    recursive: true,
+  })
+
+  function run(command, args) {
+    return spawnSync(command, args, { cwd: root, encoding: 'utf8' })
+  }
+
+  // Start with a pristine package, regardless of the caller's installed copy.
+  assert.equal(run('git', ['apply', '--reverse', `patches/${patchName}`]).status, 0)
+  assert.notEqual(run(process.execPath, ['scripts/verifyReduxBroadcastPatch.js']).status, 0)
+  assert.equal(run(process.execPath, ['scripts/applyReduxBroadcastPatch.js']).status, 0)
+  assert.equal(run(process.execPath, ['scripts/applyReduxBroadcastPatch.js']).status, 0)
+
+  const target = path.join(
+    root,
+    'node_modules/@eduardoac-skimlinks/webext-redux/lib/wrap-store/wrapStore.js',
+  )
+  fs.writeFileSync(target, 'incompatible package contents\n')
+  assert.notEqual(run(process.execPath, ['scripts/applyReduxBroadcastPatch.js']).status, 0)
+  assert.equal(fs.readFileSync(target, 'utf8'), 'incompatible package contents\n')
+})
